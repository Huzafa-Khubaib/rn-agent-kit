{
  "name": "rn-agentic-dev",
  "version": "1.0.1",
  "description": "Install React Native / Expo agent skills into Claude, Cursor, Copilot, Windsurf + AGENTS.md. Includes tokens, Jira, Maestro, CI templates.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "rn-agentic-dev": "dist/cli.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "skills",
    "templates",
    "docs",
    "README.md",
    "LICENSE",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "tokens": "tsx src/scripts/figma-tokens.ts",
    "jira-validate": "tsx src/scripts/validate-jira-tickets.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish",
    "pack:dry-run": "npm pack --dry-run",
    "pack:verify": "npm run build && npm pack --dry-run",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "react-native",
    "expo",
    "agent",
    "skills",
    "claude",
    "cursor",
    "windsurf"
  ],
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^0.10.0",
    "commander": "^13.1.0",
    "execa": "^9.6.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^9.22.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "msw": "^2.15.0",
    "prettier": "^3.5.3",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "^3.0.8"
  }
}
