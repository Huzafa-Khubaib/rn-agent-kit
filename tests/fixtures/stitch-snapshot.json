{
  "source": "stitch",
  "tailwind": {
    "colors": {
      "primary": {
        "DEFAULT": "#6750A4",
        "container": "#EADDFF"
      },
      "surface": "#FEF7FF",
      "on-surface": "#1D1B20"
    },
    "darkColors": {
      "primary": {
        "DEFAULT": "#D0BCFF",
        "container": "#4F378B"
      },
      "surface": "#141218",
      "on-surface": "#E6E0E9"
    },
    "spacing": {
      "1": "4px",
      "2": "0.5rem",
      "4": "1rem"
    },
    "borderRadius": {
      "DEFAULT": "0.25rem",
      "lg": "0.5rem",
      "full": "9999px"
    },
    "fontFamily": {
      "sans": ["Inter", "sans-serif"]
    },
    "fontSize": {
      "base": [
        "1rem",
        {
          "lineHeight": "1.5rem"
        }
      ],
      "sm": "0.875rem"
    },
    "boxShadow": {
      "md": "0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1)",
      "inner": "inset 0 2px 4px rgba(0,0,0,0.05)"
    }
  }
}
